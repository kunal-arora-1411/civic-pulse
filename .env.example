# Copy to .env for local development. Every value here is a development
# default; never reuse these outside your machine.

# --- docker compose (infra/docker-compose.yml) ------------------------------
# Compose falls back to these same defaults, so you only need to set the ones
# you change. Pass `--env-file .env` to compose to apply overrides.
POSTGRES_DB=civicpulse
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=civicpulse
APP_DB_USER=civicpulse_app
APP_DB_PASSWORD=civicpulse_app
MINIO_ROOT_USER=civicpulse
MINIO_ROOT_PASSWORD=civicpulse-minio
S3_BUCKET=civicpulse-media
# minio-init creates this user with access to S3_BUCKET only; the API and
# worker in compose use it instead of the root credentials.
S3_APP_ACCESS_KEY=civicpulse-app
S3_APP_SECRET_KEY=civicpulse-app-secret
# Web origins allowed to PUT to pre-signed upload URLs.
S3_CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# --- API (apps/api, when run on the host) -----------------------------------
ENV=development
LOG_LEVEL=INFO
# The API connects as the non-superuser app role so row-level security
# applies. Only migrations use the owner role.
DATABASE_URL=postgresql+asyncpg://civicpulse_app:civicpulse_app@localhost:5432/civicpulse
MIGRATION_DATABASE_URL=postgresql+asyncpg://civicpulse:civicpulse@localhost:5432/civicpulse
REDIS_URL=redis://localhost:6379/0
# Comma-separated. 3100 is the web app's alternate dev port.
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# --- Email (the outbox's email channel) -------------------------------------
# Compose points this at Mailpit already. Set SMTP_HOST empty to switch email
# off: the channel then records a skip against every event instead of trying.
# A real relay needs SMTP_USERNAME/SMTP_PASSWORD and SMTP_STARTTLS=true.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=CivicPulse <no-reply@civicpulse.local>
# Links inside emails point at the web app, not the API.
WEB_URL=http://localhost:3000

# --- SMS and Web Push (the outbox's other channels) -------------------------
# `console` writes sign-in codes and notification texts to the API/worker log.
SMS_PROVIDER=console
# Web Push is off while either key is empty. Generate a pair with
#   cd apps/api && uv run python scripts/vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@civicpulse.local

# Object storage. On the host, the API and the browser both reach MinIO at
# localhost:9000, so S3_PUBLIC_ENDPOINT can stay unset. In compose the API
# uses http://minio:9000 and signs browser URLs for http://localhost:9000.
S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=civicpulse-app
S3_SECRET_KEY=civicpulse-app-secret

# Reverse geocoding for address text: `nominatim` (public OSM server, one
# request per second, cached in Redis) or `none`. Wards and zones come from
# PostGIS either way.
GEOCODER=nominatim

# Secrets. Generate real ones for any shared environment, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
OTP_HMAC_SECRET=dev-only-otp-hmac-secret-change-me-0123456789
TOTP_ENCRYPTION_KEY=mMLHnH8kUFV7fWcw29AMh4zjPaVTPAsXyuGlw5mP07w=

# --- Audit chain (A6.3) ---
# The key that HMAC-signs the hourly audit checkpoint. It must not live in the
# database: defeating somebody who can write to the audit log is exactly what the
# signature is for. Required in production; elsewhere the checkpoint job logs and
# skips rather than sealing unsigned. Generate one with:
#   openssl rand -hex 32
# AUDIT_ANCHOR_KEY=
# Which key signed a checkpoint. Bump both of these to rotate, keeping the old
# secret in AUDIT_ANCHOR_PREVIOUS_KEYS so older checkpoints still verify.
AUDIT_ANCHOR_KEY_ID=k1
# AUDIT_ANCHOR_PREVIOUS_KEYS={"k0": "<the old secret>"}
# Rows per batch while walking a chain. Larger is faster and holds more memory.
AUDIT_VERIFY_BATCH_SIZE=5000
# Refuse a single verification range larger than this, so a request cannot ask
# the database to hash millions of rows in one go.
AUDIT_VERIFY_MAX_EVENTS=2000000
# How long a verification run is kept before housekeeping deletes it. The audit
# log itself and its checkpoints are never deleted by a job.
AUDIT_VERIFICATION_RETENTION_DAYS=90

# Development conveniences. Both are ignored or forced on in production.
# DEV_FIXED_OTP accepts 000000 as a valid code (never when ENV=production).
DEV_FIXED_OTP=true
# Unset means: required in production, not required elsewhere.
REQUIRE_STAFF_MFA=false
# OTP request limits per hour (production defaults: 5 per phone, 30 per IP).
# Compose loosens them because every local browser shares one gateway IP.
OTP_MAX_PER_HOUR=60
OTP_MAX_PER_IP_PER_HOUR=1000
