# Copy to .env for local development. Every value here is a development
# default; never reuse these outside your machine.

# --- docker compose (infra/docker-compose.yml) ------------------------------
# Compose falls back to these same defaults, so you only need to set the ones
# you change. Pass `--env-file .env` to compose to apply overrides.
POSTGRES_DB=civicpulse
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=civicpulse
APP_DB_USER=civicpulse_app
APP_DB_PASSWORD=civicpulse_app
MINIO_ROOT_USER=civicpulse
MINIO_ROOT_PASSWORD=civicpulse-minio
S3_BUCKET=civicpulse-media
